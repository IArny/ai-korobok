#cloud-config
hostname: ai-vm
manage_etc_hosts: true

users:
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    passwd: __PASSWORD_HASH__
    ssh_authorized_keys:
      - __SSH_PUBLIC_KEY__

ssh_pwauth: true

write_files:
  - path: /opt/opencode/skills/backlog/SKILL.md
    permissions: '0644'
    content: |
__BACKLOG_SKILL_CONTENT__

package_update: true
package_upgrade: true

packages:
  - python3
  - python3-pip
  - python3-venv
  - git
  - curl
  - wget
  - htop
  - ripgrep
  - fish
  - net-tools
  - apt-transport-https
  - ca-certificates
  - gnupg
  - lsb-release
  - build-essential
  - linux-modules-extra-generic
  - wireless-regdb

runcmd:
  - |
    echo ">>> Installing Node.js 22 LTS..."
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
    apt-get install -y nodejs
  - |
    echo ">>> Installing Docker CE..."
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
    apt-get update
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    usermod -aG docker ubuntu
  - |
    echo ">>> Installing Python AI packages..."
    pip3 install --break-system-packages uvicorn
  - |
    echo ">>> Installing LanceDB..."
    pip3 install --break-system-packages --ignore-installed lancedb pyarrow
  - |
    echo ">>> Setting up shared directory..."
    mkdir -p __MOUNT_POINT__
    echo "__MOUNT_TAG__ __MOUNT_POINT__ virtiofs defaults 0 0" >> /etc/fstab
  - |
    echo ">>> Enabling Docker..."
    systemctl enable docker
    systemctl start docker
  - |
    echo ">>> Configuring local network route..."
    LOCAL_NET="__LOCAL_NETWORK__"
    if [ -n "$LOCAL_NET" ]; then
      GW="__WIFI_GATEWAY__"
      IFACE=$(ip -4 route get "$GW" 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}}')
      if [ -n "$IFACE" ]; then
        printf 'network:\n  version: 2\n  ethernets:\n    %s:\n      routes:\n        - to: %s\n          via: %s\n' \
          "$IFACE" "$LOCAL_NET" "$GW" > /etc/netplan/60-local-network.yaml
        chmod 600 /etc/netplan/60-local-network.yaml
        netplan apply
        echo ">>> Local route ${LOCAL_NET} via ${GW} on ${IFACE} configured."
      else
        echo ">>> WARNING: no interface found for gateway ${GW}; skipping local route."
      fi
    else
      echo ">>> No local network detected; skipping local route."
    fi
  - |
    echo ">>> Installing backlog skill for opencode..."
    install -d -o ubuntu -g ubuntu /home/ubuntu/.config/opencode/skills/backlog
    install -o ubuntu -g ubuntu -m 0644 /opt/opencode/skills/backlog/SKILL.md /home/ubuntu/.config/opencode/skills/backlog/SKILL.md
  - |
    echo ">>> Installing OpenCode v2 and opencode-indexing plugin..."
    npm install -g @opencode/cli
    install -d -o ubuntu -g ubuntu /home/ubuntu/.config/opencode
    chown -R ubuntu:ubuntu /home/ubuntu/.config/opencode
    su - ubuntu -c 'npx --yes @javierkaiser/opencode-indexing@latest --aio --no-restart' || true
    if ! su - ubuntu -c 'opencode plugin list' | grep -qi 'javierkaiser'; then
      su - ubuntu -c 'tmp=$(mktemp -d) && npm install --prefix "$tmp" --no-audit --no-fund --loglevel=error @javierkaiser/opencode-indexing@latest && node "$tmp/node_modules/@javierkaiser/opencode-indexing/install.mjs" --aio --no-restart; rc=$?; rm -rf "$tmp"; exit $rc'
    fi
  - |
    echo ">>> Setup complete."
    install -d -m 0755 /var/lib/ai-korobok
    printf '%s %s\n' \
      "$(cat /proc/sys/kernel/random/boot_id)" \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      > /var/lib/ai-korobok/provisioned

power_state:
  mode: reboot
  delay: "now"
  message: "Cloud-init setup complete, rebooting..."
